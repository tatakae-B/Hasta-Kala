    <string name="title_help_support">Help &amp; Support</string>
    <string name="support_email">Email Support</string>
    <string name="support_email_desc">For app support, bug reports, or suggestions, contact us at:\n\ncontactbdriii@gmail.com</string>
    <string name="app_guide">App Guide</string>
    <string name="guide_content">Welcome to Hasta-Kala Shop\n\nHasta-Kala Shop helps artisans and small craft businesses manage sales, inventory, and business insights easily.\n\nFeatures:\n• Quick Billing\n• Best Seller Tracking\n• Stock Alerts\n• Income Tracking\n• Export Reports\n• Sales Analytics\n\nHow to Use:\n\n1. Add products to inventory.\n2. Create bills using Quick Bill.\n3. Track best-selling products.\n4. Monitor low stock alerts.\n5. Export reports anytime.\n\nTip:\nUse analytics to identify which products and colors sell the most.</string>
